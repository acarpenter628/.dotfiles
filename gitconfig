; to use, add the following to ~/.gitconfig:
; [include]
;   path = ~/.dotfiles/gitconfig

[core]
    pager = delta

[branch]
    sort = -committerdate

[pull]
    rebase = false

[alias]
    dt = "!f() { args=$@; shift $#; nvim -c \"DiffviewOpen $args\";}; f" ; doesn't work on the work computer because git is too old

[diff]
    context = 15

[diff]
    tool = nvim_difftool
    prompt = true

[difftool "nvim_difftool"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\"" 
    ; cmd = "nvim -d \"$REMOTE\" \"$LOCAL\""; Makes more sense if old is on the left, but it's annoying the cursor starts there

[merge]
    tool = nvimdiff ; this is a default one

[mergetool]
    prompt = true


[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    true-color = always
        ; this gave me more greens, but not more reds.
    side-by-side = true
    line-numbers = true
    syntax-theme = "Dracula"
    minus-style = syntax "#700000"
    minus-emph-style = syntax "#a80000"
    plus-style = syntax "#18542c"
    plus-emph-style = syntax "#21753d"
    wrap-right-percent = 1
    wrap-max-lines = 15

